# Hibachi Exchange API Configuration
# Get these from your Hibachi Exchange account
# NOTE: For paper trading (paper_main.py), API keys are NOT required.
#       Only real market data is used (public API, no auth needed).

HIBACHI_API_KEY=your_api_key_here
HIBACHI_ACCOUNT_ID=your_account_id_here
HIBACHI_PRIVATE_KEY=your_private_key_here

# ---------------------------------------------------------------------------
# Trading Configuration (used by both paper and live bots)
# ---------------------------------------------------------------------------
HIBACHI_SYMBOL=BTC/USDT-P
POSITION_SIZE_USD=100
LEVERAGE=2
TAKE_PROFIT=2.0
STOP_LOSS=-1.0
LOOP_SLEEP=3
MAX_RETRIES=60

# ---------------------------------------------------------------------------
# Paper Trading Configuration (paper_main.py / Docker)
# ---------------------------------------------------------------------------
PAPER_BALANCE=10000
PAPER_STATE_FILE=/data/paper_state.json

# Bot mode: long, short, monitor, alternate
BOT_MODE=long

# Seconds between trade cycles
CYCLE_COOLDOWN=10

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO