# Hibachi Exchange API Configuration
# Get these from your Hibachi Exchange account
# NOTE: For paper trading (paper_main.py), API keys are NOT required.
#       Only real market data is used (public API, no auth needed).

HIBACHI_API_KEY=your_api_key_here
HIBACHI_ACCOUNT_ID=your_account_id_here
HIBACHI_PRIVATE_KEY=your_private_key_here

# Optional - Trading symbol (default: BTC/USDT-P)
HIBACHI_SYMBOL=BTC/USDT-P